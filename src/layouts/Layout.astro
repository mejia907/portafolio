---
import '@fontsource-variable/archivo/wght.css';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { yearsOfExperience } from '../data/profile';

const title = 'Andrés Felipe Mejía | Desarrollador full-stack en Manizales';
const description =
	`Desarrollador full-stack en Manizales, Colombia, con ${yearsOfExperience}+ años de experiencia. Aplicaciones web y móviles con PHP, Laravel, Node.js, React y Next.js.`;
const url = new URL('/', Astro.site).href;
const socialImage = new URL('/og.jpg', Astro.site).href;

// Datos estructurados: solo información que también se ve en la página
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfilePage',
			'@id': `${url}#page`,
			url,
			name: title,
			description,
			inLanguage: 'es-CO',
			mainEntity: { '@id': `${url}#person` },
		},
		{
			'@type': 'Person',
			'@id': `${url}#person`,
			name: 'Andrés Felipe Mejía Restrepo',
			alternateName: ['Andrés Felipe Mejía', 'Andrés Mejía'],
			jobTitle: 'Desarrollador full-stack',
			description,
			url,
			image: socialImage,
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Manizales',
				addressRegion: 'Caldas',
				addressCountry: 'CO',
			},
			worksFor: { '@type': 'Organization', name: 'Cidenet', url: 'https://cidenet.com.co/' },
			knowsAbout: [
				'PHP',
				'Laravel',
				'Node.js',
				'NestJS',
				'JavaScript',
				'TypeScript',
				'React',
				'React Native',
				'Next.js',
				'Astro',
				'MySQL',
				'PostgreSQL',
				'Supabase',
			],
			sameAs: ['https://www.linkedin.com/in/andresfelipemejiar', 'https://github.com/mejia907'],
		},
		{
			'@type': 'WebSite',
			'@id': `${url}#website`,
			url,
			name: 'Andrés Felipe Mejía',
			inLanguage: 'es-CO',
			publisher: { '@id': `${url}#person` },
		},
	],
};
---
<!doctype html>
<html lang="es-CO">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#0b0d12" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Andrés Felipe Mejía Restrepo" />
		<link rel="canonical" href={url} />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:type" content="profile" />
		<meta property="og:site_name" content="Andrés Felipe Mejía" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Andrés Felipe Mejía, desarrollador full-stack en Manizales, Colombia"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<script is:inline>
			// Animación de entrada: en cada carga que empieza en la parte superior de la página
			(() => {
				const root = document.documentElement;
				const scrollKey = 'last-scroll';
				let lastScroll = 0;
				try {
					lastScroll = Number(sessionStorage.getItem(scrollKey));
					addEventListener('pagehide', () => sessionStorage.setItem(scrollKey, String(scrollY)));
				} catch {}

				// Con un ancla o una recarga a mitad de página, el inicio no está a la vista
				const navigation = performance.getEntriesByType('navigation')[0];
				const restoresScroll = navigation && navigation.type !== 'navigate' && lastScroll > 200;
				const goesToSection = location.hash && location.hash !== '#profile';
				if (restoresScroll || goesToSection) return;

				root.classList.add('intro');
				const skipEvents = ['wheel', 'touchmove', 'pointerdown', 'keydown'];
				const skipKeys = ['Tab', 'Escape', 'Enter', ' ', 'ArrowDown', 'PageDown', 'End'];
				const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

				const finish = () => {
					root.classList.remove('intro', 'intro-play');
					skipEvents.forEach((name) => removeEventListener(name, skip));
				};

				// Una tecla que sigue pulsada al recargar (F5, Ctrl+R, Enter) no cuenta
				const skip = (event) => {
					if (event.type === 'keydown' && (event.repeat || !skipKeys.includes(event.key))) return;
					finish();
				};
				skipEvents.forEach((name) => addEventListener(name, skip, { passive: true }));

				document.addEventListener('DOMContentLoaded', async () => {
					const photo = document.querySelector('#profile img');
					// Espera la fuente y la foto, pero nunca más de 1,2 s
					await Promise.race([
						Promise.allSettled([
							document.fonts.load('700 1em "Archivo Variable"'),
							photo?.decode(),
						]),
						wait(1200),
					]);
					root.classList.add('intro-play');
					// Al terminar se limpia todo, aunque la pestaña esté en segundo plano
					await wait(1400);
					finish();
				});
			})();
		</script>
	</head>
	<body class="font-sans antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-60 focus:rounded-full focus:bg-accent focus:px-5 focus:py-3 focus:text-sm focus:font-medium focus:text-on-accent"
		>
			Saltar al contenido
		</a>
		<slot />
	</body>
</html>
