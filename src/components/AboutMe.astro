---
import { Icon } from "astro-icon/components";
import Button from "./common/Button.astro";
import ColombiaMap from "./ColombiaMap.astro";
import SectionHeading from "./common/SectionHeading.astro";
import { certificates } from "../data/certificates";
import { yearsOfExperience } from "../data/profile";
import { projects } from "../data/projects";
import curriculum from "../assets/docs/HOJA_DE_VIDA_ANDRES_FELIPE_MEJIA_RESTREPO.pdf";

const facts = [
  { value: `${yearsOfExperience}+`, label: "Años de backend" },
  { value: "4+", label: "Años de frontend" },
  { value: projects.length, label: "Proyectos aquí" },
  { value: certificates.length, label: "Certificados" },
];
---

<section id="about" class="band">
  <div class="wrap grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
    <div>
      <SectionHeading title="Sobre mí" />
      <div data-reveal="in" class="mt-6 max-w-prose space-y-4 text-base leading-relaxed sm:text-lg">
        <p>
          Empecé en 2013 personalizando ERP en PHP y seguí con CRM: SugarCRM, SuiteCRM, Vtiger. Ahí aprendí a
          escuchar primero: antes de programar, quiero entender cómo funciona tu negocio y qué te está
          quitando tiempo.
        </p>
        <p>
          Desde entonces he trabajado en sistemas para salud, finanzas y comercio, y hoy también hago
          aplicaciones móviles y productos propios. En{" "}
          <a
            href="#projects"
            class="font-medium text-ink underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-accent"
          >Proyectos</a> puedes ver en qué ando.
        </p>
      </div>

      <dl data-stagger="4" class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
          facts.map((fact) => (
            <div data-reveal="both" class="panel flex flex-col-reverse items-center justify-end rounded-xl px-2 py-4 text-center">
              <dt class="mt-1 text-sm leading-snug">{fact.label}</dt>
              <dd class="text-3xl font-bold leading-none text-accent">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <Button class="mt-8" href={curriculum} download="CV-Andres-Felipe-Mejia.pdf">
        Descargar CV
        <Icon name="ph:download-simple" class="size-5 text-accent" aria-hidden="true" />
      </Button>
    </div>

    <div class="grid content-start gap-6 sm:grid-cols-[1fr_auto] sm:items-center lg:grid-cols-1 xl:grid-cols-[1fr_auto]">
      <dl data-reveal="in" class="panel grid gap-5 rounded-xl p-6">
        <div class="flex gap-4">
          <Icon name="ph:user" class="mt-0.5 size-6 shrink-0 text-accent" aria-hidden="true" />
          <div>
            <dt class="text-sm text-muted">Nombre</dt>
            <dd class="font-medium text-ink">Andrés Felipe Mejía Restrepo</dd>
          </div>
        </div>
        <div class="flex gap-4">
          <Icon name="ph:map-pin" class="mt-0.5 size-6 shrink-0 text-accent" aria-hidden="true" />
          <div>
            <dt class="text-sm text-muted">Ubicación</dt>
            <dd class="font-medium text-ink">Manizales, Colombia</dd>
          </div>
        </div>
        <div class="flex gap-4">
          <Icon name="ph:graduation-cap" class="mt-0.5 size-6 shrink-0 text-accent" aria-hidden="true" />
          <div>
            <dt class="text-sm text-muted">Educación</dt>
            <dd class="font-medium text-ink">Ingeniería de Sistemas</dd>
            <dd class="mt-1 font-medium text-ink">
              Tecnólogo en Análisis y Desarrollo de Sistemas de Información
            </dd>
          </div>
        </div>
      </dl>
      <div data-reveal="in" class="flex" style="--i: 2">
        <ColombiaMap />
      </div>
    </div>
  </div>
</section>
