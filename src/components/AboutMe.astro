---
import { Icon } from "astro-icon/components";
import SectionHeading from "./common/SectionHeading.astro";

interface Skill {
  name: string;
  icon: string;
  /** Versión monocroma para logos que se pierden sobre fondo oscuro */
  iconDark?: string;
}

const skillGroups: { title: string; items: Skill[] }[] = [
  {
    title: "Habilidades",
    items: [
      { name: "PHP", icon: "devicon:php" },
      { name: "Laravel", icon: "devicon:laravel" },
      { name: "JavaScript", icon: "devicon:javascript" },
      { name: "TypeScript", icon: "devicon:typescript" },
      { name: "Astro", icon: "devicon:astro", iconDark: "simple-icons:astro" },
      { name: "React", icon: "devicon:react" },
      { name: "Next.js", icon: "devicon:nextjs", iconDark: "simple-icons:nextdotjs" },
      { name: "Node.js", icon: "devicon:nodejs" },
      { name: "NestJS", icon: "devicon:nestjs" },
      { name: "HTML", icon: "devicon:html5" },
      { name: "jQuery", icon: "devicon:jquery", iconDark: "simple-icons:jquery" },
      { name: "CSS", icon: "devicon:css3" },
      { name: "Tailwind", icon: "devicon:tailwindcss" },
    ],
  },
  {
    title: "Bases de datos",
    items: [
      { name: "MySQL", icon: "devicon:mysql", iconDark: "simple-icons:mysql" },
      { name: "MariaDB", icon: "devicon:mariadb", iconDark: "simple-icons:mariadb" },
      { name: "MongoDB", icon: "devicon:mongodb" },
      { name: "PostgreSQL", icon: "devicon:postgresql" },
      { name: "Prisma", icon: "devicon:prisma" },
    ],
  },
];
---

<section id="about" class="py-16 md:py-24">
  <div class="wrap">
    <SectionHeading icon="hugeicons:user-square" title="Sobre mí" />

    <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-16">
      <p class="max-w-prose text-base leading-relaxed sm:text-lg">
        Como ingeniero en sistemas tengo los conocimientos, las habilidades y las
        características personales para mi adecuado desempeño en las actividades
        de análisis, diseño y programación de sistemas de información. Mi
        capacidad analítica me permite comprender necesidades del negocio y
        traducirlas en soluciones tecnológicas eficientes. Además, mi pasión por
        la innovación me impulsa a buscar constantemente nuevas formas de mejorar
        procesos y productos.
      </p>

      <dl class="grid content-start gap-6 sm:grid-cols-2 lg:grid-cols-1">
        <div>
          <dt class="font-semibold text-ink">Experiencia</dt>
          <dd class="mt-1">10+ años de desarrollo backend</dd>
          <dd class="mt-1">4+ años de desarrollo frontend</dd>
        </div>
        <div>
          <dt class="font-semibold text-ink">Educación</dt>
          <dd class="mt-1">Ingeniería de Sistemas</dd>
          <dd class="mt-1">
            Tecnólogo en Análisis y desarrollo de Sistemas de Información
          </dd>
        </div>
      </dl>
    </div>

    <div class="mt-14 grid gap-10">
      {
        skillGroups.map((group) => (
          <div>
            <h3 class="text-xl font-semibold sm:text-2xl">{group.title}</h3>
            <ul class="mt-4 flex flex-wrap gap-2 sm:gap-3">
              {group.items.map((item) => (
                <li class="inline-flex min-h-11 items-center gap-2.5 rounded-xl border border-line bg-surface px-3.5 py-2 text-sm font-medium text-ink sm:text-base">
                  <Icon
                    name={item.icon}
                    class:list={["size-6 shrink-0", item.iconDark && "dark:hidden"]}
                    aria-hidden="true"
                  />
                  {item.iconDark && (
                    <Icon
                      name={item.iconDark}
                      class="hidden size-6 shrink-0 dark:block"
                      aria-hidden="true"
                    />
                  )}
                  {item.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
