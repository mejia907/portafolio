---
import { Icon } from "astro-icon/components";
import Button from "./common/Button.astro";
import SectionHeading from "./common/SectionHeading.astro";
---

<section id="contact" class="border-t border-line py-16 md:py-24">
  <div class="wrap">
    <SectionHeading icon="hugeicons:mail-01" title="Contacto" />

    <a
      href="mailto:mejia9070@gmail.com"
      class="mt-8 inline-block py-2 text-[clamp(1.25rem,0.9rem+2.2vw,2.25rem)] font-semibold wrap-anywhere text-ink underline decoration-line-strong decoration-2 underline-offset-8 transition-colors hover:decoration-ink"
    >mejia9070@gmail.com</a>

    <div class="mt-8 flex flex-wrap gap-3">
      <Button
        href="https://www.linkedin.com/in/andresfelipemejiar"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="fa6-brands:linkedin" class="size-5" aria-hidden="true" />
        LinkedIn
      </Button>
      <Button href="https://github.com/mejia907" target="_blank" rel="noopener noreferrer">
        <Icon name="fa6-brands:github" class="size-5" aria-hidden="true" />
        GitHub
      </Button>
    </div>
  </div>
</section>
