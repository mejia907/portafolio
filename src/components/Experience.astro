---
import SectionHeading from "./common/SectionHeading.astro";

import CardExperience from "./common/CardExperience.astro";
import cidenet from "../assets/images/cidenet.webp";
import grupo_jpc from "../assets/images/grupo_jpc.webp";
import fga from "../assets/images/fga.webp";
import gbi_mark from "../assets/images/gbi_mark.webp";
import lebon from "../assets/images/lebon.webp";
import software_estrategico from "../assets/images/software_estrategico.webp";
---

<section id="experience" class="section">
  <div class="wrap">
    <SectionHeading title="Experiencia" />
    <ol data-stagger="3" class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <CardExperience
        image={cidenet}
        title="Cidenet"
        position="Analista de Desarrollo"
        dateIn="2022"
        dateOut="Actual"
        description="Desarrollo mejoras para el software de atención de pacientes de una clínica, con <strong>PHP, JavaScript, jQuery, AJAX, CSS y HTML</strong>. Trabajo con el equipo para que cada entrega cumpla lo que pidió el cliente."
        url="https://cidenet.com.co/"
      />
      <CardExperience
        image={grupo_jpc}
        title="Grupo JPC"
        position="Desarrollador TI"
        dateIn="2019"
        dateOut="2022"
        description="Adapté el CRM Vtiger <strong>(PHP)</strong> a la operación de la empresa. Con <strong>Angular</strong> y <strong>Node.js</strong> construí un sistema de pago de facturas que mantenía al día la facturación en el CRM, y otro de seguimiento de pedidos para saber en qué estado estaba cada solicitud."
        url="https://www.megatoner.co/"
      />

      <CardExperience
        image={fga}
        title="FGA Fondo de garantías"
        position="Analista de Tecnología"
        dateIn="2016"
        dateOut="2019"
        description="Fui responsable de migrar de SugarCRM a SuiteCRM, donde se gestionaban los clientes y las PQRS. Después creé módulos nuevos para sus procesos con <strong>PHP, HTML, CSS y JavaScript</strong>."
        url="https://fga.com.co/"
      />

      <CardExperience
        image={gbi_mark}
        title="GBI-Mark"
        position="Desarrollador TI"
        dateIn="2015"
        dateOut="2016"
        description="Diseñé y desarrollé interfaces para SugarCRM y SuiteCRM con <strong>PHP, HTML y CSS</strong>. Formé parte del equipo que implementaba la plataforma en cada cliente, la integré con otros sistemas y reduje los tiempos de carga de sus módulos."
      />

      <CardExperience
        image={lebon}
        title="LeBon"
        position="Analista Desarrollador"
        dateIn="2014"
        dateOut="2015"
        description="Desarrollé módulos a medida para el ERP con <strong>PHP</strong> y <strong>MySQL</strong>, integré módulos externos y mejoré el rendimiento del sistema."
      />

      <CardExperience
        image={software_estrategico}
        title="Software Estratégico"
        position="Analista Desarrollador"
        dateIn="2013"
        dateOut="2014"
        description="Diseñé y personalicé módulos de un ERP con <strong>PHP, MySQL y CSS</strong> para una empresa que dispensaba medicamentos a distintas EPS de Colombia. También integré módulos externos y mejoré su rendimiento."
        url="https://softgic.co/es/"
      />
    </ol>
  </div>
</section>
