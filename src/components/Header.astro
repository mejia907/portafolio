---
import { Icon } from "astro-icon/components";
import Button from "./common/Button.astro";
import { navigation } from "../data/navigation";
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas">
  <div class="wrap flex h-18 items-center justify-between gap-4">
    <a
      href="#profile"
      class="inline-flex min-h-11 items-center gap-2 whitespace-nowrap text-lg font-bold text-ink"
    >
      <Icon name="ph:code-bold" class="size-7 text-accent" aria-hidden="true" />
      <span><span class="text-accent">Andrés</span> Mejía</span>
    </a>

    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                class="relative inline-flex min-h-11 items-center px-2.5 text-sm font-medium transition-colors duration-200 after:absolute after:inset-x-2.5 after:bottom-1.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-accent after:transition-transform after:duration-300 hover:text-ink aria-[current]:text-accent aria-[current]:after:scale-x-100 xl:px-4 xl:after:inset-x-4"
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block">
        <Button href="#contact" class="min-h-11!">Hablemos</Button>
      </div>
      <button
        id="toggleMenu"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu"
        class="group inline-flex size-11 items-center justify-center rounded-lg text-ink transition-colors hover:bg-surface-raised lg:hidden"
        type="button"
      >
        <Icon name="ph:list" class="size-7 group-aria-expanded:hidden" aria-hidden="true" />
        <Icon name="ph:x" class="hidden size-7 group-aria-expanded:block" aria-hidden="true" />
      </button>
    </div>
  </div>

  {/* Menú móvil */}
  <nav
    id="menu"
    hidden
    aria-label="Menú móvil"
    class="absolute inset-x-0 top-full max-h-[calc(100dvh-4.5rem)] overflow-y-auto overscroll-contain border-y border-line bg-surface shadow-xl shadow-black/50 lg:hidden"
  >
    <ul class="wrap py-2">
      {
        navigation.map((item) => (
          <li class="border-b border-line last:border-b-0">
            <a
              href={item.href}
              data-nav-link
              class="flex min-h-12 items-center text-base font-medium transition-colors hover:text-ink aria-[current]:text-accent"
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;

  // Menú móvil
  const toggleMenu = document.getElementById("toggleMenu");
  const menu = document.getElementById("menu");

  const setMenuOpen = (isOpen: boolean) => {
    if (!menu || !toggleMenu) return;
    menu.hidden = !isOpen;
    toggleMenu.setAttribute("aria-expanded", String(isOpen));
    toggleMenu.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
  };

  toggleMenu?.addEventListener("click", () => setMenuOpen(Boolean(menu?.hidden)));

  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) setMenuOpen(false);
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    if (!menu?.contains(event.target) && !toggleMenu?.contains(event.target)) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || menu?.hidden) return;
    setMenuOpen(false);
    toggleMenu?.focus();
  });

  // Al pasar a escritorio se cierra; el resize de la barra del móvil no lo afecta
  window.matchMedia("(min-width: 64rem)").addEventListener("change", () => setMenuOpen(false));

  // Sección actual en la navegación
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sections = [...document.querySelectorAll<HTMLElement>("main > section[id]")];
  let ticking = false;

  const markCurrent = () => {
    ticking = false;
    const atBottom = window.innerHeight + window.scrollY >= root.scrollHeight - 2;
    const current = atBottom
      ? sections.at(-1)
      : sections.findLast(
          (section) => section.getBoundingClientRect().top <= window.innerHeight * 0.4,
        );

    for (const link of links) {
      if (link.hash === `#${current?.id}`) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  };

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(markCurrent);
    },
    { passive: true },
  );
  markCurrent();
</script>
