---
import { Icon } from "astro-icon/components";
import { navigation } from "../data/navigation";

const iconButton =
  "size-11 items-center justify-center rounded-full border border-line-strong text-ink transition-colors duration-200 hover:border-ink hover:bg-surface-raised";
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/95 backdrop-blur-sm">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a
      href="#profile"
      class="inline-flex min-h-11 items-center whitespace-nowrap text-lg font-semibold tracking-tight text-ink lg:text-xl"
    >
      Andrés F. Mejía
    </a>

    <div class="flex items-center gap-2 lg:gap-4">
      <nav class="hidden md:block" aria-label="Navegación principal">
        <ul class="flex items-center lg:gap-2">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link
                  class="inline-flex min-h-11 items-center px-2 text-sm font-medium underline-offset-8 transition-colors hover:text-ink hover:underline aria-[current]:text-ink aria-[current]:underline aria-[current]:decoration-2 lg:px-3"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button id="themeToggle" aria-label="Cambiar tema" class:list={["inline-flex", iconButton]} type="button">
        <Icon name="ph:moon-stars" class="size-5 dark:hidden" aria-hidden="true" />
        <Icon name="ph:sun-dim" class="hidden size-5 dark:block" aria-hidden="true" />
      </button>

      <button
        id="toggleMenu"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu"
        class:list={["group inline-flex md:hidden", iconButton]}
        type="button"
      >
        <Icon name="proicons:menu" class="size-6 group-aria-expanded:hidden" aria-hidden="true" />
        <Icon name="proicons:cancel" class="hidden size-6 group-aria-expanded:block" aria-hidden="true" />
      </button>
    </div>
  </div>

  {/* Menú móvil */}
  <nav
    id="menu"
    hidden
    aria-label="Menú móvil"
    class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-y border-line bg-surface shadow-lg shadow-slate-950/10 md:hidden"
  >
    <ul class="wrap py-2">
      {
        navigation.map((item) => (
          <li class="border-b border-line last:border-b-0">
            <a
              href={item.href}
              data-nav-link
              class="flex min-h-12 items-center text-base font-medium hover:text-ink aria-[current]:font-semibold aria-[current]:text-ink"
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const THEME_KEY = "theme-preference";
  const root = document.documentElement;

  // Tema
  const themeToggle = document.getElementById("themeToggle");
  const themeColor = document.querySelector('meta[name="theme-color"]');
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

  const getStoredTheme = () => {
    try {
      return localStorage.getItem(THEME_KEY);
    } catch {
      return null;
    }
  };

  const applyTheme = (isDark: boolean) => {
    root.classList.toggle("dark", isDark);
    themeColor?.setAttribute("content", isDark ? "#020617" : "#f8fafc");
    themeToggle?.setAttribute(
      "aria-label",
      isDark ? "Activar modo claro" : "Activar modo oscuro",
    );
  };

  applyTheme(root.classList.contains("dark"));

  themeToggle?.addEventListener("click", () => {
    const isDark = !root.classList.contains("dark");
    applyTheme(isDark);
    try {
      localStorage.setItem(THEME_KEY, isDark ? "dark" : "light");
    } catch {}
  });

  systemTheme.addEventListener("change", (event) => {
    if (!getStoredTheme()) applyTheme(event.matches);
  });

  // Menú móvil
  const toggleMenu = document.getElementById("toggleMenu");
  const menu = document.getElementById("menu");

  const setMenuOpen = (isOpen: boolean) => {
    if (!menu || !toggleMenu) return;
    menu.hidden = !isOpen;
    toggleMenu.setAttribute("aria-expanded", String(isOpen));
    toggleMenu.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
  };

  toggleMenu?.addEventListener("click", () => setMenuOpen(Boolean(menu?.hidden)));

  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) setMenuOpen(false);
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    if (!menu?.contains(event.target) && !toggleMenu?.contains(event.target)) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || menu?.hidden) return;
    setMenuOpen(false);
    toggleMenu?.focus();
  });

  // Al pasar a escritorio se cierra; el resize de la barra del móvil no lo afecta
  window.matchMedia("(min-width: 48rem)").addEventListener("change", () => setMenuOpen(false));

  // Sección actual en la navegación
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sections = [...document.querySelectorAll<HTMLElement>("main > section[id]")];
  let ticking = false;

  const markCurrent = () => {
    ticking = false;
    const atBottom = window.innerHeight + window.scrollY >= root.scrollHeight - 2;
    const current = atBottom
      ? sections.at(-1)
      : sections.findLast(
          (section) => section.getBoundingClientRect().top <= window.innerHeight * 0.4,
        );

    for (const link of links) {
      if (link.hash === `#${current?.id}`) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  };

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(markCurrent);
    },
    { passive: true },
  );
  markCurrent();
</script>
