---
import { Icon } from "astro-icon/components";
import Button from "./common/Button.astro";
import { navigation } from "../data/navigation";
---

<header
  class="sticky top-0 z-50 pt-3 before:absolute before:inset-x-0 before:top-0 before:-z-10 before:h-full before:bg-linear-to-b before:from-canvas before:to-transparent sm:pt-4"
>
  <div class="wrap flex items-center gap-3 lg:gap-6">
    <div
      class="panel-solid flex h-14 flex-1 items-center justify-between gap-4 rounded-xl pl-4 pr-2 lg:pr-3"
    >
      <a
        href="#profile"
        class="inline-flex min-h-11 items-center gap-2 whitespace-nowrap text-lg font-semibold text-ink"
      >
        <Icon name="ph:code-bold" class="size-6 text-glow" aria-hidden="true" />
        <span><span class="text-glow">Andrés</span> Mejía</span>
      </a>

      <nav class="hidden lg:block" aria-label="Navegación principal">
        <ul class="flex items-center gap-1">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link
                  class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-medium transition-colors duration-200 hover:text-ink aria-[current]:bg-glow/15 aria-[current]:text-glow xl:px-4"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        id="toggleMenu"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu"
        class="group inline-flex size-11 items-center justify-center rounded-lg text-ink transition-colors hover:bg-glow/15 lg:hidden"
        type="button"
      >
        <Icon name="ph:list" class="size-6 group-aria-expanded:hidden" aria-hidden="true" />
        <Icon name="ph:x" class="hidden size-6 group-aria-expanded:block" aria-hidden="true" />
      </button>
    </div>

    <div class="hidden rounded-xl bg-canvas sm:block">
      <Button href="#contact" class="h-14">
        Hablemos
        <Icon name="ph:paper-plane-tilt" class="size-5" aria-hidden="true" />
      </Button>
    </div>
  </div>

  {/* Menú móvil */}
  <nav id="menu" hidden aria-label="Menú móvil" class="absolute inset-x-0 top-full lg:hidden">
    <div class="wrap pt-2">
      <ul
        class="panel-solid max-h-[calc(100dvh-6rem)] overflow-y-auto overscroll-contain rounded-xl px-4 py-2"
      >
        {
          navigation.map((item) => (
            <li class="border-b border-line/60 last:border-b-0">
              <a
                href={item.href}
                data-nav-link
                class="flex min-h-12 items-center text-base font-medium transition-colors hover:text-ink aria-[current]:text-glow"
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;

  // Menú móvil
  const toggleMenu = document.getElementById("toggleMenu");
  const menu = document.getElementById("menu");

  const setMenuOpen = (isOpen: boolean) => {
    if (!menu || !toggleMenu) return;
    menu.hidden = !isOpen;
    toggleMenu.setAttribute("aria-expanded", String(isOpen));
    toggleMenu.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
  };

  toggleMenu?.addEventListener("click", () => setMenuOpen(Boolean(menu?.hidden)));

  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) setMenuOpen(false);
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    if (!menu?.contains(event.target) && !toggleMenu?.contains(event.target)) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || menu?.hidden) return;
    setMenuOpen(false);
    toggleMenu?.focus();
  });

  // Al pasar a escritorio se cierra; el resize de la barra del móvil no lo afecta
  window.matchMedia("(min-width: 64rem)").addEventListener("change", () => setMenuOpen(false));

  // Sección actual en la navegación
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sections = [...document.querySelectorAll<HTMLElement>("main > section[id]")];
  let ticking = false;

  const markCurrent = () => {
    ticking = false;
    const atBottom = window.innerHeight + window.scrollY >= root.scrollHeight - 2;
    const current = atBottom
      ? sections.at(-1)
      : sections.findLast(
          (section) => section.getBoundingClientRect().top <= window.innerHeight * 0.4,
        );

    for (const link of links) {
      if (link.hash === `#${current?.id}`) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  };

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(markCurrent);
    },
    { passive: true },
  );
  markCurrent();
</script>
