---
import { navigation } from "../data/navigation";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface pb-[max(2rem,env(safe-area-inset-bottom))] pt-8">
  <div class="wrap flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
    <nav aria-label="Pie de página">
      <ul class="-mx-3 flex flex-wrap text-sm font-medium">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center px-3 underline-offset-8 transition-colors hover:text-ink hover:underline"
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="text-sm text-muted">Copyright © {year} Andrés Felipe Mejía Restrepo.</p>
  </div>
</footer>
