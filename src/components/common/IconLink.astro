---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  icon: string;
  label: string;
}

const { href, icon, label } = Astro.props;
const isExternal = href.startsWith("http");
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  aria-label={label}
  class="panel inline-flex size-12 items-center justify-center rounded-lg text-ink transition-colors duration-200 hover:border-accent hover:text-accent active:opacity-80"
>
  <Icon name={icon} class="size-5" aria-hidden="true" />
</a>
