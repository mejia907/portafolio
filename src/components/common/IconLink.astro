---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  icon: string;
  label: string;
}

const { href, icon, label } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="inline-flex size-11 items-center justify-center rounded-full border border-line-strong text-ink transition-colors duration-200 hover:border-ink hover:bg-surface-raised active:opacity-80"
>
  <Icon name={icon} class="size-5" aria-hidden="true" />
</a>
