---
import { Icon } from "astro-icon/components";

const { icon, iconPlatform, namePlatform, title, date, time } = Astro.props;
---

<li class="flex gap-4 border-t border-line py-5">
  <Icon name={icon} class="size-9 shrink-0 text-ink" aria-hidden="true" />
  <div class="min-w-0">
    <h3 class="text-base font-semibold leading-snug sm:text-lg">{title}</h3>
    <p class="mt-1 text-sm text-muted">{date}</p>
    <p class="mt-1 inline-flex items-center gap-1.5 text-sm text-copy">
      <Icon name={iconPlatform} class="size-4 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
      {time ? `${namePlatform} · ${time}` : namePlatform}
    </p>
  </div>
</li>
