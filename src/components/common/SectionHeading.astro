---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<h2
  data-reveal="both"
  class="heading text-[clamp(1.75rem,1.4rem+1.6vw,2.5rem)] font-bold leading-[1.12] tracking-[-0.02em]"
>
  {title}
</h2>

<style>
  .heading::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-bottom: 1rem;
    border-radius: 2px;
    background: var(--accent);
  }
</style>
