---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  title: string;
}

const { icon, title } = Astro.props;
---

<div class="flex items-center gap-4">
  <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-glow/12 text-glow">
    <Icon name={icon} class="size-6" aria-hidden="true" />
  </span>
  <h2 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{title}</h2>
</div>
