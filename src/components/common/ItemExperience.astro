---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
const { image, title, description, position, dateIn, dateOut, url } = Astro.props;

// La última palabra va unida a la flecha para que no quede sola en otra línea
const words = title.split(" ");
const lastWord = words.pop();
const firstWords = words.length > 0 ? `${words.join(" ")} ` : "";
---

<li class="grid gap-x-10 gap-y-5 border-t border-line py-8 lg:grid-cols-[23rem_1fr]">
  <div class="flex items-start gap-4">
    <span
      class="grid size-16 shrink-0 place-items-center overflow-hidden rounded-lg border border-line bg-white p-2"
    >
      <Image src={image} alt="" class="max-h-full w-auto object-contain" />
    </span>
    <div class="min-w-0">
      <h3 class="text-lg font-semibold leading-snug sm:text-xl">
        {
          url ? (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative inline-block decoration-2 underline-offset-4 after:absolute after:-inset-x-1 after:-inset-y-2.5 hover:underline"
            >
              {firstWords}
              <span class="whitespace-nowrap">
                {lastWord}
                <Icon
                  name="uim:arrow-up-right"
                  class="ml-0.5 inline size-5 align-[-0.15em] text-muted transition-colors group-hover:text-ink"
                  aria-hidden="true"
                />
              </span>
            </a>
          ) : (
            title
          )
        }
      </h3>
      <p class="mt-1 text-base font-medium leading-snug">{position}</p>
      <p class="mt-1 text-sm tabular-nums text-muted">{dateIn} – {dateOut}</p>
    </div>
  </div>
  <p class="max-w-prose text-base leading-relaxed" set:html={description} />
</li>
