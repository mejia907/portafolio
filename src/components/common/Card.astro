---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Button from "./Button.astro";

interface Props {
  image: ImageMetadata;
  title: string;
  description: string;
  url?: string;
  github?: string;
  /** El sitio ya no está publicado: se indica en lugar del enlace */
  offline?: boolean;
  class?: string;
}

const { image, title, description, url, github, offline, class: className } = Astro.props;
---

{/* El contenedor decide: si la tarjeta es ancha, la imagen pasa a un lado */}
<article class:list={["@container", className]}>
  <div
    class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface @2xl:flex-row"
  >
    <div
      class="aspect-3/2 shrink-0 overflow-hidden border-b border-line @2xl:aspect-auto @2xl:w-1/2 @2xl:border-r @2xl:border-b-0 @4xl:w-3/5"
    >
      <Image
        src={image}
        alt={`Captura de ${title}`}
        widths={[400, 640, 960, 1280].filter((width) => width <= image.width)}
        sizes="(min-width: 768px) 640px, 100vw"
        class="h-full w-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-103"
      />
    </div>

    <div class="flex flex-1 flex-col p-5 sm:p-6 @4xl:p-10">
      <h3 class="text-xl font-semibold leading-snug @4xl:text-2xl">{title}</h3>
      <p class="mt-2 max-w-prose text-base leading-relaxed">{description}</p>

      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías">
        <slot />
      </ul>

      <div class="mt-auto flex flex-wrap items-center gap-3 pt-6">
        {offline && <p class="text-sm text-muted">Proyecto fuera de línea</p>}
        {
          url && (
            <Button
              variant="solid"
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver ahora: ${title}`}
            >
              Ver ahora
              <Icon name="uim:arrow-up-right" class="size-5" aria-hidden="true" />
            </Button>
          )
        }
        {
          github && (
            <Button
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver código de ${title}`}
            >
              <Icon name="fa6-brands:github" class="size-5" aria-hidden="true" />
              Ver código
            </Button>
          )
        }
      </div>
    </div>
  </div>
</article>
