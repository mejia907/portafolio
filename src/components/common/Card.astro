---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  image: ImageMetadata;
  title: string;
  description: string;
  url?: string;
  github?: string;
  /** El sitio ya no está publicado: se indica en lugar del enlace */
  offline?: boolean;
}

const { image, title, description, url, github, offline } = Astro.props;

const linkClass =
  "inline-flex min-h-11 items-center gap-2 text-sm font-semibold transition-colors duration-200";
---

<article
  class="panel group flex h-full flex-col rounded-xl p-3 transition-colors duration-300 hover:border-glow/60"
>
  <div class="aspect-3/2 overflow-hidden rounded-lg bg-surface">
    <Image
      src={image}
      alt={`Captura de ${title}`}
      widths={[320, 480, 640, 960].filter((width) => width <= image.width)}
      sizes="(min-width: 1280px) 280px, (min-width: 640px) 50vw, 100vw"
      class="h-full w-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-104"
    />
  </div>

  <div class="flex flex-1 flex-col px-2 pb-1 pt-4">
    <h3 class="text-lg font-semibold leading-snug">{title}</h3>
    <p class="mt-1.5 text-sm leading-relaxed">{description}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tecnologías">
      <slot />
    </ul>

    <div class="mt-auto flex min-h-11 flex-wrap items-center gap-x-5 pt-3">
      {
        url && (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ahora: ${title}`}
            class:list={[linkClass, "text-glow hover:text-glow-strong hover:underline hover:underline-offset-4"]}
          >
            Ver ahora
            <Icon name="ph:arrow-square-out" class="size-5" aria-hidden="true" />
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver código de ${title}`}
            class:list={[linkClass, "text-ink hover:text-glow"]}
          >
            <Icon name="fa6-brands:github" class="size-4.5" aria-hidden="true" />
            Ver código
          </a>
        )
      }
      {offline && <p class="text-sm text-muted">Proyecto fuera de línea</p>}
    </div>
  </div>
</article>
