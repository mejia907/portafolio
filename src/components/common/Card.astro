---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  image: ImageMetadata;
  title: string;
  description: string;
  url?: string;
  github?: string;
  offline?: boolean;
}

const { image, title, description, ...links } = Astro.props;
---

<article
  data-reveal="both"
  class="panel group flex h-full flex-col overflow-hidden rounded-xl transition-colors duration-300 hover:border-accent/70"
>
  <div class="aspect-3/2 overflow-hidden border-b border-line">
    <Image
      src={image}
      alt={`Captura de ${title}`}
      widths={[320, 480, 640, 960].filter((width) => width <= image.width)}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      class="h-full w-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-104"
    />
  </div>

  <div class="flex flex-1 flex-col px-5 pb-3 pt-5">
    <h3 class="text-xl font-semibold leading-snug">{title}</h3>
    <p class="mt-2 text-base leading-relaxed">{description}</p>
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tecnologías">
      <slot />
    </ul>
    <div class="mt-auto flex min-h-11 flex-wrap items-center gap-x-6 pt-3">
      <ProjectLinks title={title} {...links} />
    </div>
  </div>
</article>
