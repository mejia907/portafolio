---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "solid" | "outline";
}

const { variant = "outline", class: className, ...rest } = Astro.props;

const variants = {
  solid:
    "border-transparent bg-glow text-on-glow shadow-lg shadow-glow/25 hover:bg-glow-strong hover:shadow-glow/40",
  outline: "border-glow/50 bg-canvas/60 text-ink hover:border-glow hover:bg-glow/12",
};
---

<a
  class:list={[
    "inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border px-5 py-2 text-sm font-semibold transition-[background-color,border-color,box-shadow] duration-200 active:opacity-80",
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
