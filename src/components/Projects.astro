---
import FeaturedApp from "./FeaturedApp.astro";
import Card from "./common/Card.astro";
import SectionHeading from "./common/SectionHeading.astro";
import ProjectRow from "./common/ProjectRow.astro";
import { projects, type AppProject, type ImageProject } from "../data/projects";

const apps = projects.filter((project): project is AppProject => project.placement === "app");
const cards = projects.filter((project): project is ImageProject => project.placement === "card");
const rows = projects.filter((project): project is ImageProject => project.placement === "list");
---

<section id="projects" class="band">
  <div class="wrap">
    <SectionHeading title="Proyectos" />
    {apps.map((project, index) => <FeaturedApp project={project} class={index === 0 ? "mt-10" : "mt-5"} />)}
    {
      cards.length > 0 && (
        <div
          data-stagger="3"
          class:list={[
            apps.length > 0 ? "mt-5" : "mt-10",
            "grid gap-5 sm:grid-cols-2 lg:grid-cols-3",
            // En dos columnas, un número impar dejaría un hueco: la primera ocupa todo el ancho
            cards.length % 2 === 1 && "sm:max-lg:[&>:first-child]:col-span-2",
          ]}
        >
          {cards.map((project) => (
            <Card {...project} />
          ))}
        </div>
      )
    }
    {
      rows.length > 0 && (
        <>
          <h3 data-reveal="both" class="mt-16 text-2xl font-semibold tracking-[-0.01em]">
            Otros proyectos
          </h3>
          <ul class="mt-6">
            {rows.map((project) => (
              <ProjectRow {...project} />
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>
