---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Button from "./common/Button.astro";
import IconLink from "./common/IconLink.astro";
import profile from "../assets/perfil.webp";
import curriculum from "../assets/docs/HOJA_DE_VIDA_ANDRES_FELIPE_MEJIA_RESTREPO.pdf";

const nameWords = ["Andrés", "Felipe", "Mejía"];
---

<section
  id="profile"
  class="wrap grid scroll-mt-16 items-center gap-8 pb-8 max-md:justify-items-center max-md:text-center pt-10 md:grid-cols-[auto_1fr] md:gap-12 md:pb-12 md:pt-16 lg:gap-16"
>
  <Image
    src={profile}
    alt="Andrés Felipe Mejía Restrepo"
    widths={[224, 320, 448, 640]}
    sizes="(min-width: 1024px) 320px, (min-width: 768px) 224px, 176px"
    loading="eager"
    fetchpriority="high"
    data-intro
    style="--at: 350ms; --blur: 18px"
    class="size-44 rounded-full object-cover ring-4 ring-line md:size-56 lg:size-80"
  />
  <div>
    <h1 class="text-[clamp(2.25rem,1.6rem+3vw,3.75rem)] font-bold leading-[1.1] tracking-tight">
      <span data-intro class="block font-normal text-muted" style="--at: 0ms">Hola, soy{" "}</span>
      {
        nameWords.map((word, index) => (
          <>
            <span data-intro class="inline-block" style={`--at: ${80 + index * 80}ms`}>{word}</span>{" "}
          </>
        ))
      }
    </h1>
    <p data-intro style="--at: 420ms; --blur: 8px" class="mt-4 text-xl font-medium sm:text-2xl">Desarrollador FullStack.</p>
    <p data-intro style="--at: 490ms; --blur: 8px" class="mt-2 flex items-center gap-2 text-base text-muted max-md:justify-center">
      <Icon name="hugeicons:location-01" class="size-5 shrink-0" aria-hidden="true" />
      Manizales, Colombia
    </p>
    <div data-intro style="--at: 560ms; --blur: 8px" class="mt-8 flex flex-wrap items-center gap-3 max-md:justify-center">
      <Button variant="solid" href="#contact">Contacto</Button>
      <Button href={curriculum} download="CV-Andres-Felipe-Mejia.pdf">
        <Icon name="hugeicons:download-01" class="size-5" aria-hidden="true" />
        Descargar CV
      </Button>
      <div class="flex gap-3 max-md:w-full max-md:justify-center">
        <IconLink
          href="https://www.linkedin.com/in/andresfelipemejiar"
          icon="fa6-brands:linkedin"
          label="Perfil de LinkedIn"
        />
        <IconLink
          href="https://github.com/mejia907"
          icon="fa6-brands:github"
          label="Perfil de GitHub"
        />
      </div>
    </div>
  </div>
</section>
