---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Button from "./common/Button.astro";
import IconLink from "./common/IconLink.astro";
import Laptop from "./Laptop.astro";
import portrait from "../assets/perfil_escena.webp";
import curriculum from "../assets/docs/HOJA_DE_VIDA_ANDRES_FELIPE_MEJIA_RESTREPO.pdf";

const nameWords = ["Andrés", "Felipe", "Mejía"];

const facts = [
  { icon: "ph:hard-drives", value: "10+ años", label: "Desarrollo backend" },
  { icon: "ph:browser", value: "4+ años", label: "Desarrollo frontend" },
  { icon: "ph:folder-notch", value: "8 proyectos", label: "En este portafolio" },
  { icon: "ph:certificate", value: "8 certificados", label: "Platzi, MongoDB y CertiProf" },
];
---

<section id="profile" class="wrap scroll-mt-24 pt-4 sm:pt-6">
  <div class="panel hero rounded-2xl px-5 pb-8 pt-6 sm:px-8 lg:px-10 lg:py-10">
    <div class="hero-portrait" data-intro style="--at: 350ms; --blur: 18px">
      <Image
        src={portrait}
        alt="Andrés Felipe Mejía Restrepo"
        widths={[360, 540, 720, 1022]}
        sizes="(min-width: 1024px) 560px, (min-width: 640px) 420px, 320px"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="hero-text max-lg:text-center">
      <p
        data-intro
        style="--at: 0ms; --blur: 8px"
        class="inline-flex items-center gap-2 rounded-lg bg-glow/12 px-3 py-1.5 text-sm font-medium text-glow"
      >
        <Icon name="ph:map-pin" class="size-4 shrink-0" aria-hidden="true" />
        Manizales, Colombia
      </p>
      <h1
        class="mt-5 text-[clamp(2.25rem,1.55rem+2.6vw,3.5rem)] font-semibold leading-[1.08] tracking-tight"
      >
        <span data-intro class="block font-normal text-muted" style="--at: 0ms">Hola, soy{" "}</span>
        <span class="text-glow">
          {
            nameWords.map((word, index) => (
              <>
                <span data-intro class="inline-block" style={`--at: ${80 + index * 80}ms`}>
                  {word}
                  {index === nameWords.length - 1 && <span class="caret" aria-hidden="true" />}
                </span>{" "}
              </>
            ))
          }
        </span>
      </h1>
      <p data-intro style="--at: 420ms; --blur: 8px" class="mt-4 text-xl font-medium text-ink">
        Desarrollador FullStack.
      </p>
      <p
        data-intro
        style="--at: 490ms; --blur: 8px"
        class="mt-4 max-w-[36ch] text-base lg:max-w-[30ch] leading-relaxed max-lg:mx-auto"
      >
        Construyo aplicaciones web escalables y eficientes desde el front-end hasta el back-end.
      </p>
      <div
        data-intro
        style="--at: 560ms; --blur: 8px"
        class="mt-8 flex flex-wrap gap-3 max-lg:justify-center max-sm:mx-auto max-sm:max-w-64 max-sm:flex-col"
      >
        <Button variant="solid" href="#projects">
          Ver proyectos
          <Icon name="ph:arrow-up-right" class="size-5" aria-hidden="true" />
        </Button>
        <Button href={curriculum} download="CV-Andres-Felipe-Mejia.pdf">
          Descargar CV
          <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
        </Button>
      </div>
    </div>

    <div class="hero-side" data-intro style="--at: 560ms; --blur: 8px">
      <dl class="panel grid grid-cols-2 gap-x-4 gap-y-5 rounded-xl p-5 lg:grid-cols-1 lg:p-6">
        {
          facts.map((fact) => (
            <div class="flex gap-3 max-sm:flex-col max-sm:gap-2 sm:items-start">
              <Icon name={fact.icon} class="size-6 shrink-0 text-glow" aria-hidden="true" />
              <div class="flex flex-col-reverse">
                <dt class="text-sm leading-snug">{fact.label}</dt>
                <dd class="font-semibold leading-snug text-ink">{fact.value}</dd>
              </div>
            </div>
          ))
        }
      </dl>
      <div class="mt-4 flex gap-3 max-lg:justify-center">
        <IconLink
          href="https://github.com/mejia907"
          icon="fa6-brands:github"
          label="Perfil de GitHub"
        />
        <IconLink
          href="https://www.linkedin.com/in/andresfelipemejiar"
          icon="fa6-brands:linkedin"
          label="Perfil de LinkedIn"
        />
        <IconLink
          href="mailto:mejia9070@gmail.com"
          icon="ph:envelope-simple-bold"
          label="Enviar un correo"
        />
      </div>
    </div>

    <div class="hero-laptop" data-intro style="--at: 480ms; --blur: 14px">
      <Laptop />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    justify-items: center;
    isolation: isolate;
  }

  /* Luz ambiental del panel, por debajo del rostro */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      ellipse 20rem 14rem at 50% 15rem,
      color-mix(in oklab, var(--glow) 17%, transparent),
      transparent 72%
    );
  }

  .hero-portrait {
    width: min(78%, 16rem);
    margin-bottom: -4rem;
  }

  .hero-portrait :global(img) {
    width: 100%;
    height: auto;
    mask-image: linear-gradient(#000 58%, transparent 96%);
  }

  .hero-side {
    width: 100%;
    max-width: 34rem;
  }

  .hero-laptop {
    display: none;
    width: 100%;
    max-width: 27rem;
    pointer-events: none;
  }

  @media (width >= 40rem) {
    .hero-portrait {
      width: 20rem;
    }

    .hero-laptop {
      display: block;
    }
  }

  @media (width >= 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 17.5rem;
      min-height: 41rem;
      gap: 0;
      justify-items: stretch;
      align-items: start;
    }

    .hero::before {
      background: radial-gradient(
        ellipse 34rem 22rem at 66% 82%,
        color-mix(in oklab, var(--glow) 24%, transparent),
        transparent 72%
      );
    }

    .hero-text {
      grid-column: 1;
      grid-row: 1;
      max-width: 25rem;
      padding-top: 1rem;
    }

    .hero-side {
      grid-column: 2;
      grid-row: 1;
    }

    .hero-portrait {
      position: absolute;
      z-index: -1;
      bottom: 1.5rem;
      left: 46.5%;
      width: 25rem;
      margin: 0;
      translate: -50% 0;
    }

    .hero-portrait :global(img) {
      mask-image: linear-gradient(#000 55%, transparent 94%);
    }

    .hero-laptop {
      position: absolute;
      right: -0.75rem;
      bottom: -6rem;
      max-width: 30rem;
    }
  }

  @media (width >= 80rem) {
    .hero {
      min-height: 43rem;
      grid-template-columns: minmax(0, 1fr) 20rem;
    }

    .hero-portrait {
      left: 45.5%;
      width: 32rem;
    }

    .hero-laptop {
      right: -1.5rem;
      bottom: -8.5rem;
      max-width: 37rem;
    }
  }
</style>
