---
import SectionHeading from "./common/SectionHeading.astro";
import CardCertificate from "./common/CardCertificate.astro";
import { certificates } from "../data/certificates";
---

<section id="certificates" class="section pt-0!">
  <div class="wrap">
    <SectionHeading title="Certificados" />
    <ul data-stagger="4" class="mt-10 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
      {certificates.map((certificate) => <CardCertificate {...certificate} />)}
    </ul>
  </div>
</section>
