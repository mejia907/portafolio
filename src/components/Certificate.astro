---
import SectionHeading from "./common/SectionHeading.astro";
import CardCertificate from "./common/CardCertificate.astro";
---

<section id="certificates" class="pt-20 lg:pt-28">
  <div class="wrap">
    <SectionHeading icon="ph:certificate" title="Certificados" />
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
      <CardCertificate
        icon="devicon:laravel"
        iconPlatform="simple-icons:platzi"
        namePlatform="Platzi"
        title="Introducción a Laravel 9"
        date="03 de Junio de 2024"
        time="15 Hrs"
      />

      <CardCertificate
        icon="devicon:php"
        iconPlatform="simple-icons:platzi"
        namePlatform="Platzi"
        title="Introducción a Frameworks con PHP"
        date="15 de Abril de 2024"
        time="3 Hrs"
      />

      <CardCertificate
        icon="devicon:vuejs"
        iconPlatform="simple-icons:platzi"
        namePlatform="Platzi"
        title="Introducción y fundamentos de Vue.js"
        date="13 de Agosto de 2024"
        time="22 Hrs"
      />

      <CardCertificate
        icon="devicon:java"
        iconPlatform="simple-icons:platzi"
        namePlatform="Platzi"
        title="Introducción a Java"
        date="27 de Agosto de 2024"
        time="15 Hrs"
      />

      <CardCertificate
        icon="devicon:java"
        iconPlatform="simple-icons:platzi"
        namePlatform="Platzi"
        title="Java SE Orientado a Objetos"
        date="23 de Septiembre de 2024"
        time="16 Hrs"
      />

      <CardCertificate
        icon="devicon:mongodb"
        iconPlatform="devicon:mongodb"
        namePlatform="MongoDB"
        title="Getting Started with MongoDB"
        date="02 de Agosto de 2024"
      />

      <CardCertificate
        icon="devicon:docker"
        iconPlatform="simple-icons:platzi"
        namePlatform="Platzi"
        title="Docker: Fundamentos"
        date="06 de Mayo de 2024"
        time="14 Hrs"
      />

      <CardCertificate
        icon="ph:certificate"
        iconPlatform="ph:certificate"
        namePlatform="CertiProf"
        title="SCRUM Foundation Professional Certificate"
        date="15 de Mayo de 2024"
      />
    </ul>
  </div>
</section>
