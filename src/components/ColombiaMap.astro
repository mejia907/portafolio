---
// Contorno aproximado de Colombia (longitud, latitud); los puntos se generan al compilar
const outline = [
  [-71.7, 12.45], [-71.1, 12.1], [-71.4, 11.8], [-72.0, 11.6], [-72.3, 11.1], [-72.9, 10.5],
  [-73.0, 9.8], [-73.35, 9.15], [-72.8, 9.1], [-72.4, 8.4], [-72.45, 7.5], [-72.0, 7.0],
  [-70.9, 7.05], [-70.1, 6.95], [-69.4, 6.1], [-67.45, 6.2], [-67.5, 5.6], [-67.85, 4.5],
  [-67.6, 3.7], [-67.3, 3.4], [-67.85, 2.85], [-67.2, 2.3], [-66.87, 1.25], [-67.1, 1.15],
  [-67.5, 1.75], [-67.95, 1.75], [-69.8, 1.7], [-69.85, 1.05], [-69.2, 0.95], [-69.25, 0.6],
  [-69.5, 0.7], [-70.0, 0.55], [-70.0, -0.2], [-69.55, -0.55], [-69.4, -1.1], [-69.9, -4.25],
  [-70.4, -3.75], [-70.7, -3.75], [-70.05, -2.75], [-70.8, -2.25], [-71.4, -2.35], [-71.8, -2.15],
  [-72.35, -2.45], [-73.1, -2.3], [-73.65, -1.25], [-74.1, -1.0], [-74.45, -0.55], [-75.1, -0.05],
  [-75.4, -0.15], [-75.8, 0.1], [-76.3, 0.4], [-76.6, 0.25], [-77.4, 0.4], [-77.7, 0.85],
  [-77.85, 0.8], [-78.85, 1.4], [-79.0, 1.7], [-78.6, 1.8], [-78.65, 2.25], [-78.4, 2.6],
  [-77.9, 2.7], [-77.5, 3.3], [-77.1, 3.85], [-77.5, 4.1], [-77.3, 4.7], [-77.55, 5.6],
  [-77.3, 5.85], [-77.5, 6.7], [-77.9, 7.2], [-77.75, 7.7], [-77.4, 7.65], [-77.25, 7.95],
  [-77.5, 8.5], [-77.35, 8.65], [-76.85, 8.65], [-76.1, 9.35], [-75.65, 9.45], [-75.65, 9.8],
  [-75.5, 10.6], [-74.9, 11.05], [-74.3, 11.0], [-74.2, 11.3], [-73.4, 11.25], [-72.6, 11.75],
  [-72.2, 11.95],
];

const step = 0.44;
const scale = 16;
const toX = (longitude: number) => (longitude + 79.4) * scale;
const toY = (latitude: number) => (12.9 - latitude) * scale;

const isInside = (x: number, y: number) =>
  outline.reduce((inside, [xi, yi], i) => {
    const [xj, yj] = outline[(i + outline.length - 1) % outline.length];
    const crosses = yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi;
    return crosses ? !inside : inside;
  }, false);

const dots = [];
for (let latitude = 12.7, row = 0; latitude > -4.5; latitude -= step, row++) {
  for (let longitude = -79.2 + (row % 2) * (step / 2); longitude < -66.6; longitude += step) {
    if (isInside(longitude, latitude)) dots.push([toX(longitude), toY(latitude)]);
  }
}

const home = { x: toX(-75.52), y: toY(5.07) };
---

<svg
  class="map"
  viewBox="0 0 206 280"
  role="img"
  aria-label="Mapa de Colombia con Manizales señalada"
>
  {dots.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="1.7" class="dot" />)}
  <circle cx={home.x} cy={home.y} r="13" class="halo"></circle>
  <circle cx={home.x} cy={home.y} r="13" class="halo pulse"></circle>
  <circle cx={home.x} cy={home.y} r="4.5" class="home"></circle>
</svg>

<style>
  .map {
    width: 11.5rem;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }

  .dot {
    fill: var(--line-strong);
  }

  .home {
    fill: var(--accent);
  }

  .halo {
    fill: var(--accent);
    opacity: 0.28;
    transform-box: fill-box;
    transform-origin: center;
  }

  .pulse {
    animation: pulse 2.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(0.4);
      opacity: 0.6;
    }

    to {
      transform: scale(2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
      opacity: 0;
    }
  }
</style>
